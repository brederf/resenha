# Copie este arquivo para ".env" e preencha. O ".env" nunca vai pro GitHub.

# Project URL (Supabase > Project Settings > API)
VITE_SUPABASE_URL=

# Chave pública (publishable ou anon). Pode ficar no app.
VITE_SUPABASE_ANON_KEY=

# Chave secreta (secret ou service_role). Só pro script de importação e pro robô. Nunca no app.
SUPABASE_SERVICE_ROLE_KEY=

# Seu e-mail de login, pra importação saber quem é o dono dos dados
DONO_EMAIL=
